{
  "name": "oura-ring-plugin",
  "displayName": "Oura Ring",
  "version": "1.2.1",
  "type": "data-source",
  "minHostVersion": "1.0.0",
  "description": "Oura Ring API v2からヘルスデータを取得",
  "author": "Health Manager Agent",
  "main": "dist/index.js",
  "supportedDataTypes": [
    { "name": "sleep_duration", "displayName": "睡眠時間", "category": "睡眠", "unit": "hours" },
    { "name": "deep_sleep", "displayName": "深い睡眠", "category": "睡眠", "unit": "hours" },
    { "name": "rem_sleep", "displayName": "レム睡眠", "category": "睡眠", "unit": "hours" },
    { "name": "steps", "displayName": "歩数", "category": "活動", "unit": "count" },
    { "name": "heart_rate", "displayName": "心拍数", "category": "心臓", "unit": "bpm" },
    { "name": "spo2", "displayName": "血中酸素", "category": "心臓", "unit": "%" },
    { "name": "temperature_deviation", "displayName": "体温偏差", "category": "体温", "unit": "°C" },
    { "name": "vo2_max", "displayName": "VO2 Max", "category": "フィットネス", "unit": "ml/kg/min", "description": "最大酸素摂取量" },
    { "name": "cardiovascular_age", "displayName": "心血管年齢", "category": "心臓", "unit": "years", "description": "心血管系の健康状態を年齢で表現" },
    { "name": "workout_duration", "displayName": "ワークアウト時間", "category": "活動", "unit": "minutes" },
    { "name": "workout_calories", "displayName": "ワークアウトカロリー", "category": "活動", "unit": "kcal" },
    { "name": "session_duration", "displayName": "セッション時間", "category": "精神", "unit": "minutes", "description": "瞑想・リラクゼーション等のセッション時間" },
    { "name": "oura:sleep_score", "displayName": "睡眠スコア", "category": "睡眠", "unit": "score", "description": "Oura独自の睡眠スコア" },
    { "name": "calories_burned", "displayName": "消費カロリー", "category": "活動", "unit": "kcal" },
    { "name": "oura:readiness_score", "displayName": "レディネススコア", "category": "活動", "unit": "score", "description": "Oura独自のレディネススコア" },
    { "name": "oura:activity_score", "displayName": "活動スコア", "category": "活動", "unit": "score", "description": "Oura独自の活動スコア" },
    { "name": "oura:active_calories", "displayName": "アクティブカロリー", "category": "活動", "unit": "kcal" },
    { "name": "oura:stress_level", "displayName": "ストレスレベル", "category": "精神", "unit": "score", "description": "Oura独自のストレススコア" },
    { "name": "oura:resilience", "displayName": "レジリエンス", "category": "精神", "unit": "level", "description": "ストレスからの回復力（1-5）" },
    { "name": "oura:workout_distance", "displayName": "ワークアウト距離", "category": "活動", "unit": "meters" },
    { "name": "oura:recommended_bedtime", "displayName": "推奨就寝時刻", "category": "睡眠", "unit": "hour", "description": "最適な就寝時刻（24時間形式）" },
    { "name": "oura:tag", "displayName": "タグ", "category": "その他", "unit": "count", "description": "ユーザー作成のタグ" },
    { "name": "oura:rest_mode_duration", "displayName": "休息モード期間", "category": "その他", "unit": "days", "description": "休息モードの期間" }
  ],
  "fetchStrategy": "both",
  "defaultFetchInterval": 60,
  "configSchema": {
    "accessToken": {
      "type": "string",
      "label": "Personal Access Token",
      "description": "Oura Cloudで生成したアクセストークン（https://cloud.ouraring.com/personal-access-tokens）",
      "required": true,
      "secret": true
    }
  }
}
