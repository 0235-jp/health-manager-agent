{
  "name": "oura-ring-plugin",
  "displayName": "Oura Ring",
  "version": "1.3.0",
  "type": "data-source",
  "minHostVersion": "1.1.0",
  "description": "Oura Ring API v2からヘルスデータを取得",
  "author": "Health Manager Agent",
  "main": "dist/index.js",
  "supportedDataTypes": [
    { "name": "sleep_duration", "displayName": "睡眠時間", "category": "睡眠", "unit": "hours" },
    { "name": "deep_sleep", "displayName": "深い睡眠", "category": "睡眠", "unit": "hours" },
    { "name": "rem_sleep", "displayName": "レム睡眠", "category": "睡眠", "unit": "hours" },
    { "name": "light_sleep", "displayName": "浅い睡眠", "category": "睡眠", "unit": "hours" },
    { "name": "sleep_efficiency", "displayName": "睡眠効率", "category": "睡眠", "unit": "%" },
    { "name": "sleep_latency", "displayName": "入眠潜時", "category": "睡眠", "unit": "minutes" },
    { "name": "time_in_bed", "displayName": "在床時間", "category": "睡眠", "unit": "hours" },
    { "name": "awake_time", "displayName": "中途覚醒時間", "category": "睡眠", "unit": "minutes" },
    { "name": "steps", "displayName": "歩数", "category": "活動", "unit": "count" },
    { "name": "heart_rate", "displayName": "心拍数", "category": "心臓", "unit": "bpm" },
    { "name": "spo2", "displayName": "血中酸素", "category": "心臓", "unit": "%" },
    { "name": "respiratory_rate", "displayName": "呼吸数", "category": "心臓", "unit": "brpm" },
    { "name": "temperature_deviation", "displayName": "体温偏差", "category": "体温", "unit": "°C" },
    { "name": "vo2_max", "displayName": "VO2 Max", "category": "フィットネス", "unit": "ml/kg/min", "description": "最大酸素摂取量" },
    { "name": "cardiovascular_age", "displayName": "心血管年齢", "category": "心臓", "unit": "years", "description": "心血管系の健康状態を年齢で表現" },
    { "name": "workout_duration", "displayName": "ワークアウト時間", "category": "活動", "unit": "minutes" },
    { "name": "workout_calories", "displayName": "ワークアウトカロリー", "category": "活動", "unit": "kcal" },
    { "name": "session_duration", "displayName": "セッション時間", "category": "精神", "unit": "minutes", "description": "瞑想・リラクゼーション等のセッション時間" },
    { "name": "calories_burned", "displayName": "消費カロリー", "category": "活動", "unit": "kcal" },
    { "name": "sedentary_time", "displayName": "座位時間", "category": "活動", "unit": "hours" },

    { "name": "oura:sleep_score", "displayName": "睡眠スコア", "category": "睡眠", "unit": "score", "description": "Oura独自の睡眠スコア" },
    { "name": "oura:readiness_score", "displayName": "レディネススコア", "category": "活動", "unit": "score", "description": "Oura独自のレディネススコア" },
    { "name": "oura:activity_score", "displayName": "活動スコア", "category": "活動", "unit": "score", "description": "Oura独自の活動スコア" },
    { "name": "oura:active_calories", "displayName": "アクティブカロリー", "category": "活動", "unit": "kcal" },
    { "name": "oura:stress_level", "displayName": "ストレスレベル", "category": "精神", "unit": "score", "description": "Oura独自のストレススコア" },
    { "name": "oura:resilience", "displayName": "レジリエンス", "category": "精神", "unit": "level", "description": "ストレスからの回復力（1-5）" },
    { "name": "oura:workout_distance", "displayName": "ワークアウト距離", "category": "活動", "unit": "meters" },
    { "name": "oura:recommended_bedtime", "displayName": "推奨就寝時刻", "category": "睡眠", "unit": "hour", "description": "最適な就寝時刻（24時間形式）" },
    { "name": "oura:tag", "displayName": "タグ", "category": "その他", "unit": "count", "description": "ユーザー作成のタグ" },
    { "name": "oura:rest_mode_duration", "displayName": "休息モード期間", "category": "その他", "unit": "days", "description": "休息モードの期間" },
    { "name": "oura:walking_distance", "displayName": "歩行相当距離", "category": "活動", "unit": "meters" },
    { "name": "oura:high_activity_time", "displayName": "高強度活動時間", "category": "活動", "unit": "minutes" },
    { "name": "oura:medium_activity_time", "displayName": "中強度活動時間", "category": "活動", "unit": "minutes" },
    { "name": "oura:low_activity_time", "displayName": "低強度活動時間", "category": "活動", "unit": "minutes" },
    { "name": "oura:bedtime_start", "displayName": "就寝時刻", "category": "睡眠", "unit": "datetime" },
    { "name": "oura:bedtime_end", "displayName": "起床時刻", "category": "睡眠", "unit": "datetime" },
    { "name": "oura:restless_periods", "displayName": "不穏睡眠回数", "category": "睡眠", "unit": "count" },
    { "name": "oura:lowest_hr", "displayName": "最低心拍数", "category": "心臓", "unit": "bpm" },
    { "name": "oura:sleep_hr_avg", "displayName": "睡眠中平均心拍", "category": "心臓", "unit": "bpm" },
    { "name": "oura:sleep_hrv_avg", "displayName": "睡眠中平均HRV", "category": "心臓", "unit": "ms" },
    { "name": "oura:recovery_time", "displayName": "回復時間", "category": "精神", "unit": "seconds" },
    { "name": "oura:stress_summary", "displayName": "ストレス要約", "category": "精神", "unit": "text" },

    { "name": "heart_rate_timeseries", "displayName": "心拍数（時系列）", "category": "心臓", "unit": "bpm", "timeseries": true, "interval": 60 },
    { "name": "oura:sleep_hr", "displayName": "睡眠中心拍数", "category": "心臓", "unit": "bpm", "timeseries": true, "interval": 300, "description": "睡眠中の心拍数（5分間隔）" },
    { "name": "oura:sleep_hrv", "displayName": "睡眠中HRV", "category": "心臓", "unit": "ms", "timeseries": true, "interval": 300, "description": "睡眠中のHRV（5分間隔）" },
    { "name": "oura:met", "displayName": "MET値", "category": "活動", "unit": "met", "timeseries": true, "interval": 60, "description": "代謝等量（1分間隔）" },
    { "name": "oura:sleep_phase", "displayName": "睡眠フェーズ", "category": "睡眠", "unit": "phase", "timeseries": true, "interval": 300, "description": "睡眠フェーズ（5分間隔、1=deep,2=light,3=rem,4=awake）" },
    { "name": "oura:activity_class", "displayName": "アクティビティクラス", "category": "活動", "unit": "class", "timeseries": true, "interval": 300, "description": "活動レベル（5分間隔、0-5）" }
  ],
  "fetchStrategy": "both",
  "defaultFetchInterval": 60,
  "configSchema": {
    "accessToken": {
      "type": "string",
      "label": "Personal Access Token",
      "description": "Oura Cloudで生成したアクセストークン（https://cloud.ouraring.com/personal-access-tokens）",
      "required": true,
      "secret": true
    }
  }
}
