{
  "name": "webhook-notification",
  "displayName": "Webhook通知",
  "version": "1.0.0",
  "type": "notification",
  "minHostVersion": "1.0.0",
  "description": "Webhookを使用してレポートやアラートを外部サービスに通知",
  "author": "Health Manager Agent",
  "main": "dist/index.js",
  "supportedEvents": [
    "report:generated",
    "report:daily",
    "health:alert",
    "data:fetched"
  ],
  "deliveryMethod": "push",
  "configSchema": {
    "webhookUrl": {
      "type": "string",
      "label": "Webhook URL",
      "description": "通知を送信するWebhook URL",
      "required": true
    },
    "enabledEvents": {
      "type": "multiselect",
      "label": "有効なイベント",
      "description": "通知するイベントを選択",
      "options": [
        { "value": "report:daily", "label": "日次レポート" },
        { "value": "report:generated", "label": "取得時レポート" },
        { "value": "health:alert", "label": "ヘルスアラート" },
        { "value": "data:fetched", "label": "データ取得完了" }
      ],
      "default": ["report:daily", "health:alert"]
    },
    "includeFullReport": {
      "type": "boolean",
      "label": "フルレポートを含める",
      "description": "レポート全文を通知に含める",
      "default": true
    }
  }
}
