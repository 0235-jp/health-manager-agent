{
  "name": "claude-agent-sdk",
  "displayName": "Claude Agent SDK",
  "version": "1.2.0",
  "type": "agent",
  "minHostVersion": "1.0.0",
  "description": "Claude Agent SDKを使用したAI分析プラグイン",
  "author": "Health Manager Agent",
  "main": "dist/index.js",
  "provider": "anthropic",
  "supportedModels": ["claude-opus-4-5-20251101", "claude-sonnet-4-20250514"],
  "capabilities": {
    "streaming": false,
    "functionCalling": true,
    "structuredOutput": true,
    "vision": false,
    "skills": true
  },
  "configSchema": {
    "model": {
      "type": "select",
      "label": "モデル",
      "description": "使用するClaudeモデル",
      "default": "claude-opus-4-5-20251101",
      "options": [
        { "value": "claude-opus-4-5-20251101", "label": "Claude Opus 4.5" },
        { "value": "claude-sonnet-4-20250514", "label": "Claude Sonnet 4" }
      ]
    },
    "apiKey": {
      "type": "string",
      "label": "API Key",
      "description": "Anthropic API Key",
      "required": false,
      "secret": true
    },
    "baseUrl": {
      "type": "string",
      "label": "Base URL",
      "description": "カスタムエンドポイント（通常は空欄でOK）",
      "required": false
    }
  }
}
