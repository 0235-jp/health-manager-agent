# Server
PORT=3001

# Frontend (dev)
VITE_PORT=5173

# Frontend (production preview)
VITE_PREVIEW_PORT=4173

# API proxy target (used by Vite dev server)
VITE_API_TARGET=http://localhost:3001

# Allowed hosts for Vite dev/preview server (comma-separated)
# VITE_ALLOWED_HOSTS=your-domain.example.com

# CORS allowed origin
CORS_ORIGIN=http://localhost:5173

# Authentication (optional - if unset, no authrequired)
# HEALTH_MANAGER_BEARER_TOKEN=your-secret-token
# CF_ACCESS_CLIENT_ID=your-client-id
# CF_ACCESS_CLIENT_SECRET=your-client-secret
