{
  "name": "health-manager-mcp",
  "description": "Health Manager MCP 接続プラグイン",
  "version": "1.1.0",
  "mcpServers": {
    "health-manager": {
      "type": "http",
      "url": "${HEALTH_MANAGER_URL:-http://localhost:3001}/mcp",
      "headers": {
        "Authorization": "Bearer ${HEALTH_MANAGER_BEARER_TOKEN}",
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
